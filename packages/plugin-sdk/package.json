{
  "name": "@openspindle/plugin-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Build OpenSpindle plugins: sandboxed React views, companion processes, the Vite preset and the openspindle-plugin CLI.",
  "type": "module",
  "exports": {
    ".": {
      "openspindle-source": "./src/index.ts",
      "types": "./types/packages/plugin-sdk/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "openspindle-source": "./src/ui.ts",
      "types": "./types/packages/plugin-sdk/src/ui.d.ts",
      "default": "./src/ui.ts"
    },
    "./companion": {
      "openspindle-source": "./src/companion.ts",
      "types": "./types/packages/plugin-sdk/src/companion.d.ts",
      "default": "./src/companion.ts"
    },
    "./frame": {
      "openspindle-source": "./src/frame.ts",
      "types": "./types/packages/plugin-sdk/src/frame.d.ts",
      "default": "./src/frame.ts"
    },
    "./node": "./src/node/index.ts",
    "./vite": {
      "openspindle-source": "./src/vite.ts",
      "types": "./types/packages/plugin-sdk/src/vite.d.ts",
      "default": "./src/vite.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "src",
    "types"
  ],
  "bin": {
    "openspindle-plugin": "./src/cli.ts"
  },
  "dependencies": {
    "@openspindle/plugin-core": "0.1.0",
    "@openspindle/rpc": "0.1.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/react": "^19",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
